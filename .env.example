# =============================================================================
# Domu Tech — Environment example (copie para .env.local / Vercel)
# NÃO coloque secrets reais neste arquivo.
# =============================================================================

# --- Meta Cloud API ---
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_VERIFY_TOKEN=
META_APP_SECRET=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Segurança (mín. 32 caracteres cada) ---
DOMU_SESSION_SECRET=
ENCRYPTION_SECRET_KEY=
# Cron Vercel: Authorization Bearer com este valor (vercel.json → /api/campaigns/run-due a cada 5 min)
CRON_SECRET=
DOMU_ADMIN_SECRET=

# E-mails (vírgula) com acesso a /interno — painel da operação. Sem isto, a rota responde 404.
PLATFORM_ADMIN_EMAILS=

# --- E-mail (Resend) — obrigatório em produção ---
RESEND_API_KEY=
EMAIL_FROM=Domu Tech <onboarding@resend.dev>

# --- Asaas (billing) ---
# sandbox | production
ASAAS_ENV=sandbox
# Em .env.local, se a chave começar com $, escape: ASAAS_API_KEY=\$aact_...
ASAAS_API_KEY=
# Obrigatório para o webhook (header asaas-access-token)
ASAAS_WEBHOOK_TOKEN=
# Nunca true em produção
BILLING_MOCK=false
